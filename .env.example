# Copy to .env and set real values. .env is gitignored - never commit it.
# docker compose refuses to start until the four required values are set.

# --- Required secrets (no defaults) ---
# PostgreSQL password (use a long random value, e.g. `openssl rand -hex 24`)
DB_PASSWORD=
# API key the backend sends to the Hermes gateway
HERMES_API_KEY=
# MQTT broker account (anonymous access is disabled). Shared by the broker,
# backend, the three services and anything else publishing/subscribing.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Optional ---
# Opt-in API keys for the three event services and their MCP sidecars
# (writes/ingest/MCP calls are unauthenticated when empty).
SIM_API_KEY=
TABLE_SIM_API_KEY=
FOOTFALL_SIM_API_KEY=
MCP_API_KEY=
# CAFE_TABLE_COUNT=15
# Image naming for the three event services (and their MCP sidecars, which
# share the same image): ${IMAGE_REGISTRY}/<service>:${IMAGE_TAG}.
# IMAGE_REGISTRY must be lowercase with no trailing slash. Rebuild (--build)
# after code changes; `latest` is reused as-is.
# IMAGE_REGISTRY=ghcr.io/your-org
# IMAGE_TAG=latest
