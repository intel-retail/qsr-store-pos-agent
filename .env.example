# Copy to .env and set real values. .env is gitignored - never commit it.
# docker compose refuses to start until the four required values are set.

# --- Required secrets (no defaults) ---
# PostgreSQL password (use a long random value, e.g. `openssl rand -hex 24`)
DB_PASSWORD=
# API key the backend sends to the Hermes gateway
HERMES_API_KEY=
# MQTT broker account (anonymous access is disabled). Shared by the broker,
# backend, the three services and anything else publishing/subscribing.
MQTT_USERNAME=
MQTT_PASSWORD=

# --- Optional ---
# Opt-in API keys for the three event services and their MCP sidecars
# (writes/ingest/MCP calls are unauthenticated when empty).
SIM_API_KEY=
TABLE_SIM_API_KEY=
FOOTFALL_SIM_API_KEY=
MCP_API_KEY=
# Push events to the qsr-agent webhook (unset = off). From a container on the same
# host, the agent's published port is reachable as host.docker.internal:8600.
# QSR_AGENT_EVENT_URL=http://host.docker.internal:8600/autonomy/events
# QSR_AGENT_STORE_ID=qsr-001          # must match the agent's QSR_RESTAURANT_ID
# QSR_AGENT_EVENT_TYPES=              # empty = per-service defaults; * = every event
# QSR_AGENT_QUEUE_MIN_DEPTH=3         # store-activity: forward queue.depth_changed only at/above this depth
# QSR_AGENT_DIRTY_MIN_TABLES=         # table-occupancy: forward table.dirty when this many tables are dirty at once (default 45% of tables)
# QSR_AGENT_MIN_INTERVAL_MS=30000     # per event type + ref; the agent runs one model call per event
# QSR_AGENT_API_KEY=                  # sent as a Bearer token if the agent sits behind a proxy
# CAFE_TABLE_COUNT=15
# Image naming for the three event services (and their MCP sidecars, which
# share the same image): ${IMAGE_REGISTRY}/<service>:${IMAGE_TAG}.
# IMAGE_REGISTRY must be lowercase with no trailing slash. Rebuild (--build)
# after code changes; `latest` is reused as-is.
# IMAGE_REGISTRY=ghcr.io/your-org
# IMAGE_TAG=latest
